generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model categoria_instrumento {
  id_categoria     Int     @id(map: "pk_categoria_instrumento") @default(autoincrement())
  nombre_categoria String  @unique(map: "uq_categoria_instrumento_nombre") @db.VarChar(100)
  descripcion      String? @db.VarChar(255)
}

